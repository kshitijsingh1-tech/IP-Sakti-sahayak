# =============================================================================
# IP-SAKTI Sahayak — Complete Environment Configuration
# Autonomous AYUSH Intellectual Property & Biodiversity Audit Engine
#
# Copy this file to .env and fill in your secrets.
# NEVER commit .env to version control.
# =============================================================================


# ---------------------------------------------------------------------------
# Application Runtime
# ---------------------------------------------------------------------------
ENV=development                        # development | production
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:5174


# ---------------------------------------------------------------------------
# LLM Layer — Primary + Fallback Chain
# ---------------------------------------------------------------------------
# Priority order: groq → gemini → ollama
LLM_PROVIDER=groq

# --- Groq (Primary — free tier, fastest inference) ---
# Get key at: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=qwen/qwen3.6-27b
# Alternatives: llama-3.3-70b-versatile | mixtral-8x7b-32768 | qwen-2.5-72b

# --- Google Gemini (Fallback) ---
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-xxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# --- Ollama (Local / Air-gapped fallback) ---
# Install: https://ollama.ai — then: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Agent tuning
AGENT_TEMPERATURE=0.1
AGENT_MAX_TOKENS=2048
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=2
ENABLE_PARALLEL_AGENTS=true


# ---------------------------------------------------------------------------
# Embedding Model
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384


# ---------------------------------------------------------------------------
# Vector Database
# ---------------------------------------------------------------------------
RAG_PROVIDER=chroma                    # chroma | pgvector | qdrant

# ChromaDB (local, zero-config for dev)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_AYUSH=ayush_statutory_corpus
CHROMA_COLLECTION_TKDL=tkdl_classical_corpora
CHROMA_COLLECTION_PATENT=ipo_patent_records

# PostgreSQL + pgvector (production)
POSTGRES_URL=postgresql://postgres:password@localhost:5432/ipsakti

# RAG retrieval settings
RAG_TOP_K=8
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_SIMILARITY_THRESHOLD=0.72


# ---------------------------------------------------------------------------
# Bhashini — Multilingual (EN/HI/SA/TA/TE/KN/ML/BN/GU/MR/PA/UR)
# ---------------------------------------------------------------------------
# Apply at: https://bhashini.gov.in/api-register
BHASHINI_API_KEY=your-bhashini-ulca-api-key
BHASHINI_USER_ID=your-bhashini-user-id
BHASHINI_INFERENCE_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline
# Voice (STT/TTS) — same credentials, different task type
BHASHINI_ENABLE_VOICE=false


# ---------------------------------------------------------------------------
# TKDL — Traditional Knowledge Digital Library (CSIR-NISCPR)
# ---------------------------------------------------------------------------
# Apply at: https://tkdl.gov.in (restricted — institutional access)
TKDL_API_ENDPOINT=https://tkdl.gov.in/api/v2
TKDL_ACCESS_TOKEN=your-tkdl-institutional-token
TKDL_CACHE_TTL_HOURS=24


# ---------------------------------------------------------------------------
# Indian Patent Office (IPO) — InPASS
# ---------------------------------------------------------------------------
# Apply at: https://ipindiaonline.gov.in
IPO_API_ENDPOINT=https://ipindiaservices.gov.in/api
IPO_API_KEY=your-ipo-api-key
IPO_SEARCH_TIMEOUT_SECONDS=15


# ---------------------------------------------------------------------------
# National Biodiversity Authority (NBA)
# ---------------------------------------------------------------------------
# Apply at: https://nbaindia.org (institutional API access)
NBA_API_ENDPOINT=https://nbaindia.org/api/v1/abs
NBA_API_KEY=your-nba-api-key
NBA_TIMEOUT_SECONDS=10


# ---------------------------------------------------------------------------
# WIPO — PATENTSCOPE International Patent Search
# ---------------------------------------------------------------------------
# Apply at: https://patentscope.wipo.int/search/en/search.jsf
WIPO_API_KEY=your-wipo-patentscope-api-key
WIPO_API_ENDPOINT=https://patentscope.wipo.int/api
WIPO_TIMEOUT_SECONDS=20


# ---------------------------------------------------------------------------
# European Patent Office (EPO) — Open Patent Services (OPS)
# ---------------------------------------------------------------------------
# Apply at: https://developers.epo.org/user/register
EPO_CLIENT_ID=your-epo-client-id
EPO_CLIENT_SECRET=your-epo-client-secret
EPO_OPS_ENDPOINT=https://ops.epo.org/3.2
EPO_TIMEOUT_SECONDS=15


# ---------------------------------------------------------------------------
# USPTO (United States Patent Office)
# ---------------------------------------------------------------------------
# Free, no key needed for PatentsView API
USPTO_API_ENDPOINT=https://api.patentsview.org/patents/query
USPTO_API_KEY=your-optional-uspto-api-key


# ---------------------------------------------------------------------------
# Statutory Corpus — Download & Ingestion
# ---------------------------------------------------------------------------
# Local paths for downloaded statutory PDFs
STATUTORY_DOCS_DIR=./data/statutes/
TKDL_CORPUS_DIR=./data/tkdl/
PATENT_CORPUS_DIR=./data/patents/

# Which corpora to auto-ingest on first run (see scripts/ingest_corpus.py)
INGEST_PATENTS_ACT=true
INGEST_BD_ACT=true
INGEST_TKDL=true
INGEST_WIPO_GRATK=true
INGEST_FSSAI=true
INGEST_API_PHARMACOPOEIA=true
INGEST_TRADEMARK_ACT=true
INGEST_GI_ACT=true
INGEST_DESIGNS_ACT=true
INGEST_PPVFR_ACT=true
INGEST_DRUGS_COSMETICS_ACT=true
INGEST_MAGIC_REMEDIES_ACT=true
INGEST_DPDP_ACT=true
INGEST_NAGOYA_PROTOCOL=true
INGEST_TRIPS_AGREEMENT=true
INGEST_EMA_THMPD=true
INGEST_WHO_MONOGRAPHS=true


# ---------------------------------------------------------------------------
# Document Upload
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_TYPES=pdf,csv,docx,pptx,txt,jpg,jpeg,png,webp,gif
UPLOAD_DIR=./uploads/
TEMP_DIR=./tmp/


# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SECRET_KEY=change-this-to-a-256-bit-random-hex-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_AUDIT_PER_HOUR=100


# ---------------------------------------------------------------------------
# DPDP / Privacy & Audit Logging
# ---------------------------------------------------------------------------
ENABLE_REQUEST_LOGGING=true
ENABLE_AGENT_TRACE=true
ENABLE_AUDIT_LOG=true
AUDIT_LOG_PATH=./logs/audit.jsonl
# Data retention
AUDIT_LOG_RETENTION_DAYS=365
# Consent for paid-source lookups (explicit user permission required)
REQUIRE_PAID_SOURCE_CONSENT=true


# ---------------------------------------------------------------------------
# LangSmith Tracing (optional — LangChain observability)
# ---------------------------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__xxxxxxxx
LANGCHAIN_PROJECT=ip-sakti-sahayak


# ---------------------------------------------------------------------------
# Redis Cache (optional — audit result caching)
# ---------------------------------------------------------------------------
USE_CACHE=false
REDIS_URL=redis://localhost:6379/0
CACHE_AUDIT_TTL_SECONDS=3600


# ---------------------------------------------------------------------------
# Escalation — AYUSH IP Facilitator Email
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
FACILITATOR_EMAIL=ipfacilitator@ayush.gov.in
ESCALATION_SUBJECT=IP-SAKTI Sahayak — User Escalation Request
